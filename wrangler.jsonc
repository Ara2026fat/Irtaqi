{
  // ══ ارتقِ — إعدادُ النشرِ على Cloudflare Workers ══
  // الاسمُ هو اسمُ المستودعِ وهو اسمُ النطاق: قاعدةٌ واحدةٌ لا تُخالَف.
  "name": "irtaqi",

  // الخدمةُ الخلفيّةُ وحدَها. ملفّاتُ الموقعِ (index.html والخطوط) تَبقى حيث هي على GitHub Pages،
  // ولا نَضمُّها هنا لأنَّ جذرَ المستودعِ يَحمل ملفّاتٍ خاصّةً (CONTRACT.md) لا تُنشر للناس.
  // وإن أردتَ لاحقًا أن يَخدم هذا العاملُ الموقعَ أيضًا فانظر فصلَ «حين يَصل النطاق» في api/README.md.
  "main": "api/worker.js",

  // تاريخُ التوافق: يُثبّت سلوكَ بيئةِ التشغيلِ فلا يتبدّل تحت قدميك.
  "compatibility_date": "2026-09-06",

  // كلَّ دقيقة: يَسأل العاملُ «مَن حان وِردُه؟» باستعلامٍ مُفهرسٍ على next_at.
  // ١٤٤٠ استدعاءً في اليومِ — أي ١٫٤٪ من حدِّ الطلباتِ المجّانيّ.
  "triggers": { "crons": ["* * * * *"] },

  // ضَع database_id بعد `wrangler d1 create irtaqi-db` (الأمرُ يَطبعه).
  "d1_databases": [
    { "binding": "DB", "database_name": "irtaqi-db", "database_id": "" }
  ],

  "vars": { "VAPID_SUBJECT": "mailto:ara1979fat@gmail.com" },

  "observability": { "enabled": true }
}
